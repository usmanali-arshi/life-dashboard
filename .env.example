# ---- Google OAuth (from Google Cloud console, see google-cloud-setup.md) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of this deployment. No trailing slash.
# Must match a redirect URI registered in the Google console.
APP_URL=http://localhost:3000

# ---- Secrets you generate locally ----
# openssl rand -base64 32   -- AES-256-GCM key for refresh tokens at rest.
# LOSING THIS MEANS RECONNECTING EVERY ACCOUNT.
TOKEN_ENC_KEY= lKu1VFs75XgmfjE0vUyg/z3ozKzNE7Ft5wAPqGTKKzk=
# openssl rand -hex 32      -- shared secret for the GitHub Actions cron
CRON_SECRET= 63645e8179e82fac304259347a5377d35ec4059898243ba4b05bb51d992fc05f

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
PUBLIC_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Feature flags ----
# false => the app never requests a restricted Gmail scope. See architecture.md section 7.
ENABLE_GMAIL=true
